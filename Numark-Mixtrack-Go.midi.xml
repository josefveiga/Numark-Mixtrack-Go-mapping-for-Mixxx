<?xml version="1.0" encoding="utf-8"?>
<MixxxControllerPreset mixxxVersion="2.3.0+" schemaVersion="1">
  <info>
    <name>Numark Mixtrack Go</name>
    <author>mixo101</author>
    <description>Midi mapping for the Numark Mixtrack Go controller</description>
  </info>
  <settings>
    <group label="Jog Wheel">
      <option variable="pitchBendSharpness" label="Pitch Bend Sharpness" type="enum">
        <value label="Very Fine">0.1</value>
        <value label="Fine (good with aligned beatgrips and sync enabled)">0.2</value>
        <value label="Normal" default="true">0.6</value>
        <value label="Coarse (better for manual beatmatching)">0.8</value>
        <value label="Very Coarse">1</value>
        <description>
          Select the sharpness of the pitch bend.
        </description>
      </option>
      <option variable="stripSearchSpeed" label="Seek Speed (top touch when deck is stopped)" type="integer" min="1" max="10" step="1" default="1">
        <description>
          Select a seek speed for when the deck is not playing.
        </description>
      </option>
      <option variable="vinylModeDefaultStateOn" label="Vinyl Mode Default State On" type="boolean" default="true">
        <description>
          Check this box for the Vinyl Mode to be activated from the start.
        </description>
      </option>
    </group>
    <group label="Loops">
      <option variable="loopPadSizesPreset" label="Loop pad sizes in loops mode (beats)" type="enum">
        <value label="1, 2, 4, 8" default="true">0</value>
        <value label="1/2, 1, 2, 4">1</value>
        <value label="1/4, 1/2, 1, 2">2</value>
        <value label="4, 8, 16, 32">3</value>
        <value label="1/4, 1/8, 1/16, 1/32 bar (4/4): 1, 1/2, 1/4, 1/8 beats">4</value>
        <value label="1, 1/2, 1/8, 1/16 bar (4/4): 4, 2, 1/2, 1/4 beats">5</value>
        <value label="1/2, 1/4, 1/8, 1/16 bar (4/4): 2, 1, 1/2, 1/4 beats">6</value>
        <description>
          Select the beat loop sizes that the 4 pads trigger in loops mode (pad 1 to pad 4).
        </description>
      </option>
    </group>
    <group label="Play/Pause Fade">
      <option variable="playFadeDurationSeconds" label="Play/Pause Fade Duration (seconds)" type="real" min="0" max="10" step="0.1" precision="1" default="1.5">
        <description>
          Shared fade-in and fade-out duration for Play/Pause on both decks.
          Set 0 for immediate play and pause without fading.
        </description>
      </option>
    </group>
    <group label="Auto Next">
      <option variable="autoNextLeftDeck" label="Enable Auto Next on Deck 1" type="boolean" default="false">
        <description>
          When the left deck naturally reaches the end, select the next library row
          and load/play it after the configured delay. Deck 2 is unaffected.
        </description>
      </option>
      <option variable="autoNextRightDeck" label="Enable Auto Next on Deck 2" type="boolean" default="false">
        <description>
          When the right deck naturally reaches the end, select the next library row
          and load/play it on Deck 2 after the configured delay. Deck 1 is unaffected.
        </description>
      </option>
      <option variable="autoNextDelaySeconds" label="Auto Next Delay (seconds)" type="integer" min="0" max="30" step="1" default="3">
        <description>
          Shared delay in seconds for Auto Next on either deck, from 0 to 30.
          Set 0 to start without an intentional delay.
        </description>
      </option>
    </group>
    <group label="Initial LEDs state">
      <option variable="initialLEDSettingDelay" label="Initial LEDs Setting Delay" type="integer" min="1" max="5" step="1" default="1">
        <description>
          Select the delay of the initial setting of LEDs. It should happen after the lightshow is finished.
        </description>
      </option>
    </group>
  </settings>
